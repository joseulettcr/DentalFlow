# Public Vite configuration. Leave values empty until their corresponding tasks.
VITE_APP_NAME=DentalFlow

# Supabase Cloud (configured in T-02/T-04). Never put service-role keys in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Solo backend (api/*): nunca en variables VITE_*. Las APIs /api/admin/* la usan para leer staff_profiles.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (configured in T-10). These values remain server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_ENCRYPTION_KEY=
