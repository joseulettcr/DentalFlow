{
  "name": "dentalflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:vercel",
    "dev:vercel": "vercel dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:p10": "vitest run --config vitest.integration.config.ts tests/integration/p10-anon-data-api.test.ts",
    "test:t03": "vitest run --config vitest.integration.config.ts tests/integration/t03-booking-integrity.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^32.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "pg": "^8.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vercel": "^66.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
