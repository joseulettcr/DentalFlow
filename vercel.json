{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "vite --port $PORT",
  "rewrites": [
    {
      "source": "/api/admin/doctors/:id/schedules",
      "destination": "/api/admin/doctors/:id?part=schedules"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/disponibilidad",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}
